# Copy to .env and fill in. Never commit .env.
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://campuscore:campuscore@localhost:5432/campuscore

# Generate with: python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
QR_ENCRYPTION_KEY=

# Frontend dev server origin(s). Never "*".
CORS_ORIGINS=["http://localhost:5173"]

# No-show job runs inside the API every N seconds.
RUN_NO_SHOW_JOB=true
NO_SHOW_JOB_INTERVAL_SECONDS=60

# Tests use a separate database (created by docker/init-test-db.sql).
# TEST_DATABASE_URL=postgresql+psycopg://campuscore:campuscore@localhost:5432/campuscore_test
